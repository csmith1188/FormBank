<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FormBank - <%= user %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 50%, #0D3D10 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .header {
            background: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .header h1 {
            color: #333;
            margin-bottom: 10px;
        }
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }
        .stat-card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .stat-card h3 {
            color: #666;
            font-size: 14px;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .stat-card .value {
            font-size: 32px;
            font-weight: bold;
            color: #2E7D32;
        }
        .stat-card .sub {
            color: #666;
            font-size: 13px;
            margin-top: 6px;
        }
        .score-poor { color: #c62828 !important; }
        .score-fair { color: #ef6c00 !important; }
        .score-good { color: #2E7D32 !important; }
        .score-very-good { color: #1565c0 !important; }
        .score-exceptional { color: #6a1b9a !important; }
        .section {
            background: white;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .section h2 {
            color: #333;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #2E7D32;
        }
        .loan-details {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .loan-details p {
            margin: 8px 0;
            color: #555;
        }
        .loan-details strong {
            color: #333;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            color: #333;
            font-weight: 500;
        }
        .form-group input {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            font-size: 16px;
            transition: border-color 0.3s;
        }
        .form-group input:focus {
            outline: none;
            border-color: #2E7D32;
        }
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            margin-right: 10px;
            margin-top: 10px;
        }
        .btn-primary {
            background: #2E7D32;
            color: white;
        }
        .btn-primary:hover {
            background: #1B5E20;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(46, 125, 50, 0.4);
        }
        .btn-success {
            background: #48bb78;
            color: white;
        }
        .btn-success:hover {
            background: #38a169;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(72, 187, 120, 0.3);
        }
        .btn:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
        }
        .alert {
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
        }
        .alert-info {
            background: #E8F5E9;
            color: #1B5E20;
            border-left: 4px solid #2E7D32;
        }
        .alert-warning {
            background: #fefcbf;
            color: #744210;
            border-left: 4px solid #d69e2e;
        }
        .alert-success {
            background: #c6f6d5;
            color: #22543d;
            border-left: 4px solid #48bb78;
        }
        .alert-error {
            background: #fed7d7;
            color: #742a2a;
            border-left: 4px solid #e53e3e;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #e0e0e0;
        }
        th {
            background: #f8f9fa;
            font-weight: 600;
            color: #333;
        }
        tr:hover {
            background: #f8f9fa;
        }
        tr.highscore-you {
            background: #E8F5E9;
        }
        tr.highscore-you:hover {
            background: #C8E6C9;
        }
        .rank-medal {
            font-weight: 700;
            color: #2E7D32;
        }
        .status-badge {
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
        }
        .status-active {
            background: #fed7d7;
            color: #742a2a;
        }
        .status-paid {
            background: #c6f6d5;
            color: #22543d;
        }
        .message {
            margin-top: 15px;
            padding: 12px;
            border-radius: 6px;
            display: none;
        }
        .message.show {
            display: block;
        }
        .nav-link {
            color: #2E7D32;
            text-decoration: none;
            margin-left: 20px;
        }
        .nav-link:hover {
            color: #1B5E20;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>FormBank System</h1>
            <p>
                Welcome, <strong><%= user %></strong> |
                <a href="/" class="nav-link">Home</a>
                <a href="/checks" class="nav-link">Checks</a>
                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <a href="/admin" class="nav-link">Admin</a>
                <% } %>
                <a href="/logout" class="nav-link">Logout</a>
            </p>
        </div>

        <div class="stats">
            <%
                var scoreClass = 'score-fair';
                if (creditScore >= 800) scoreClass = 'score-exceptional';
                else if (creditScore >= 740) scoreClass = 'score-very-good';
                else if (creditScore >= 670) scoreClass = 'score-good';
                else if (creditScore < 580) scoreClass = 'score-poor';
                var interestPct = (interestRate * 100).toFixed(2);
                var feePct = (checkFeeRate * 100).toFixed(1);
            %>
            <div class="stat-card">
                <h3>Credit Score</h3>
                <div class="value <%= scoreClass %>"><%= creditScore %></div>
                <div class="sub"><%= creditScoreLabel %> (300–850)</div>
            </div>
            <div class="stat-card">
                <h3>Credit Limit</h3>
                <div class="value"><%= creditLimit %></div>
                <div class="sub">Based on your score</div>
            </div>
            <div class="stat-card">
                <h3>Your APR</h3>
                <div class="value"><%= interestPct %>%</div>
                <div class="sub">Compounds <%= typeof compoundTest !== 'undefined' && compoundTest ? 'every 30 min (test)' : 'nightly' %></div>
            </div>
            <div class="stat-card">
                <h3>Credit Balance</h3>
                <div class="value"><%= creditBalance %></div>
                <div class="sub">Overpayment credit</div>
            </div>
            <% if (activeLoan) { %>
            <div class="stat-card">
                <h3>Remaining Owed</h3>
                <div class="value"><%= activeLoan.amount_owed - activeLoan.amount_paid %></div>
            </div>
            <% } %>
        </div>

        <% if (activeLoan) { %>
        <div class="section">
            <h2>Active Loan</h2>
            <div class="loan-details">
                <p><strong>Principal:</strong> <%= activeLoan.principal %> digipogs</p>
                <p><strong>Origination fee:</strong> 10% (included in balance at issue)</p>
                <p><strong>APR:</strong> <%= (activeLoan.interest_rate * 100).toFixed(2) %>% (compounds <%= typeof compoundTest !== 'undefined' && compoundTest ? 'every 30 minutes while COMPOUND_TEST is on' : 'every night at midnight' %>)</p>
                <p><strong>Total Owed:</strong> <%= activeLoan.amount_owed %> digipogs</p>
                <p><strong>Amount Paid:</strong> <%= activeLoan.amount_paid %> digipogs</p>
                <p><strong>Remaining:</strong> <strong style="color: #e53e3e;"><%= activeLoan.amount_owed - activeLoan.amount_paid %> digipogs</strong></p>
                <%
                    var minDue = activeLoan.min_payment_due || 0;
                    var periodPaidAmt = activeLoan.period_paid || 0;
                    var towardMin = Math.min(periodPaidAmt, minDue);
                    var stillNeed = Math.max(0, minDue - periodPaidAmt);
                    var overdue = typeof scoreExplain !== 'undefined' && scoreExplain && scoreExplain.currentlyOverdue;
                %>
                <p><strong>Minimum payment:</strong> <%= minDue %> digipogs
                    (<%= towardMin %> / <%= minDue %> this period<% if (stillNeed > 0) { %>; <span style="color:#c62828;"><%= stillNeed %> still needed</span><% } else { %>; <span style="color:#2E7D32;">minimum met</span><% } %>)</p>
                <% if (activeLoan.next_due_at) { %>
                <p><strong>Next due:</strong>
                    <span style="<%= overdue ? 'color:#c62828;font-weight:600;' : '' %>">
                        <%= new Date(activeLoan.next_due_at).toLocaleString() %>
                        <%= overdue ? '(OVERDUE)' : '' %>
                    </span>
                </p>
                <% } %>
                <p><strong>On-time streak:</strong> <%= activeLoan.on_time_streak || 0 %>
                    · <strong>Missed payments:</strong> <%= activeLoan.missed_payments || 0 %></p>
                <p><strong>Loan Date:</strong> <%= new Date(activeLoan.created_at).toLocaleDateString() %></p>
                <% if (activeLoan.last_compounded_at) { %>
                <p><strong>Last interest compound:</strong> <%= new Date(activeLoan.last_compounded_at).toLocaleString() %></p>
                <% } %>
            </div>

            <div class="alert alert-info">
                <strong>Note:</strong> When you repay, Formbar applies a 10% tax. If you send R digipogs, the lender receives 0.9*R, but your loan balance decreases by R (the pre-tax amount you sent).
                Meet the <strong>minimum payment</strong> before each due date to grow your on-time streak; missing it hurts your score more than simply carrying a balance.
            </div>

            <h3 style="margin-top: 20px; margin-bottom: 15px;">Make a Payment</h3>
            <form id="repayForm" onsubmit="return submitRepay(event)">
                <div class="form-group">
                    <label for="repayAmount">Repayment Amount (digipogs)</label>
                    <input type="number" id="repayAmount" name="amount" min="1" required>
                    <small style="color: #666;">
                        Minimum still needed this period: <%= stillNeed %> digipogs
                        · Full payoff: <%= activeLoan.amount_owed - activeLoan.amount_paid %> digipogs
                    </small>
                </div>
                <div class="form-group">
                    <label for="repayPin">PIN (required for repayment)</label>
                    <input type="password" id="repayPin" name="pin" placeholder="Your digipog PIN" required autocomplete="off">
                </div>
                <button type="submit" class="btn btn-success">Make Payment</button>
                <button type="button" class="btn btn-primary" onclick="repayFull()">Pay Full Amount</button>
            </form>
            <div id="repayMessage" class="message"></div>
        </div>
        <% } else { %>
        <div class="section">
            <h2>Borrow Digipogs</h2>
            <div class="alert alert-info">
                <strong>Loan Terms:</strong> Borrowing adds a <strong>one-time 10% fee</strong> to what you owe, then interest compounds on your remaining balance
                <% if (typeof compoundTest !== 'undefined' && compoundTest) { %>
                <strong>every 30 minutes</strong> (COMPOUND_TEST)
                <% } else { %>
                <strong>every night at midnight</strong>
                <% } %>
                at <strong><%= interestPct %>% APR</strong> (score <%= creditScore %> · <%= creditScoreLabel %>).
                Borrow up to <strong><%= creditLimit %></strong> digipogs. When you borrow P, you receive 0.9×P after Formbar tax and start owing 1.10×P.
                Minimum payments (10% of remaining, at least 25) are due <%= typeof compoundTest !== 'undefined' && compoundTest ? 'every 30 minutes in test mode' : 'every 7 days' %>.
                One active loan at a time. Check fees are currently <%= feePct %>% (min <%= checkFeeMin %> digipogs).
            </div>
            <form id="borrowForm" onsubmit="return submitBorrow(event)">
                <div class="form-group">
                    <label for="borrowAmount">Loan Amount (digipogs)</label>
                    <input type="number" id="borrowAmount" name="amount" min="1" max="<%= creditLimit %>" required>
                    <small style="color: #666;">Maximum: <%= creditLimit %> digipogs · 10% fee + <%= interestPct %>% APR</small>
                </div>
                <button type="submit" class="btn btn-primary">Request Loan</button>
            </form>
            <div id="borrowMessage" class="message"></div>
        </div>
        <% } %>

        <div class="section">
            <h2>How your score works</h2>
            <p style="color:#555; line-height:1.6; margin-bottom:12px;">
                Scores range from <strong>300–850</strong>. The loop that builds credit: take a loan, pay it back
                <strong>fully</strong> and <strong>quickly</strong>, then repeat. Scores are recalculated whenever interest compounds
                (<%= typeof compoundTest !== 'undefined' && compoundTest ? 'every 30 minutes in test mode' : 'every night at midnight' %>).
            </p>
            <ul style="color:#555; line-height:1.7; margin-left:20px; margin-bottom:14px;">
                <li><strong>Utilization:</strong> borrowing a large share of your limit at once lowers your score</li>
                <li><strong>Unpaid balance:</strong> the more of an open loan still unpaid, the more you lose</li>
                <li><strong>Payments:</strong> you gain score in proportion to how much you’ve paid back</li>
                <li><strong>Minimum due dates:</strong> pay at least the minimum before each due date — misses hurt more than carrying a balance; on-time streaks boost your score</li>
                <li><strong>Payoff speed:</strong> finishing loans in days (not weeks) adds bonus points</li>
                <li><strong>Open too long:</strong> leaving a balance open past a week slowly drains your score</li>
            </ul>
            <% if (typeof scoreExplain !== 'undefined' && scoreExplain) { %>
            <p style="color:#555; line-height:1.6; margin-bottom:12px;">
                Your snapshot:
                <% if (scoreExplain.hasActiveLoan) { %>
                utilization <strong><%= Math.round(scoreExplain.utilization * 100) %>%</strong> of limit,
                unpaid <strong><%= Math.round(scoreExplain.unpaidRatio * 100) %>%</strong> of current loan,
                paid progress <strong><%= Math.round(scoreExplain.paidPortion * 100) %>%</strong>,
                on-time streak <strong><%= scoreExplain.onTimeStreak %></strong>,
                missed payments <strong><%= scoreExplain.missedPayments %></strong><%= scoreExplain.currentlyOverdue ? ', <span style="color:#c62828;">currently overdue</span>' : '' %>,
                <% } else { %>
                no active loan (clean utilization),
                missed payments (lifetime) <strong><%= scoreExplain.missedPayments %></strong>,
                <% } %>
                <strong><%= scoreExplain.paidLoans %></strong> loan<%= scoreExplain.paidLoans === 1 ? '' : 's' %> paid in full.
            </p>
            <% } %>
            <ul style="color:#555; line-height:1.7; margin-left:20px;">
                <li><strong>Poor</strong> (300–579): starting range for new borrowers; lowest limits (from 250), highest interest &amp; fees</li>
                <li><strong>Fair</strong> (580–669): building history</li>
                <li><strong>Good</strong> (670–739): better rates and higher limit</li>
                <li><strong>Very Good</strong> (740–799): strong terms</li>
                <li><strong>Exceptional</strong> (800–850): best terms, up to 1,000,000 digipog limit</li>
            </ul>
        </div>

        <div class="section">
            <h2>Credit Score Highscores</h2>
            <p style="color:#666; margin-bottom: 8px;">Top 20 credit scores across FormBank.</p>
            <% if (highscores && highscores.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>User</th>
                        <th>Score</th>
                        <th>Rating</th>
                        <th>Credit Limit</th>
                    </tr>
                </thead>
                <tbody>
                    <% highscores.forEach(function(row, index) { %>
                    <% var isYou = row.user_id === userId; %>
                    <tr class="<%= isYou ? 'highscore-you' : '' %>">
                        <td class="rank-medal">#<%= index + 1 %></td>
                        <td>
                            <%- formbarUserLink(row.user_id, userNames) %>
                            <% if (isYou) { %> <span style="color:#2E7D32; font-weight:600;">(you)</span><% } %>
                        </td>
                        <td><strong><%= row.credit_score %></strong></td>
                        <td><%= row.score_label %></td>
                        <td><%= row.current_limit %> digipogs</td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <p style="color: #666;">No scores yet. Borrow and repay to appear on the board.</p>
            <% } %>
        </div>

        <div class="section">
            <h2>Loan History</h2>
            <% if (loanHistory && loanHistory.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Principal</th>
                        <th>APR</th>
                        <th>Total Owed</th>
                        <th>Amount Paid</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% loanHistory.forEach(loan => { %>
                    <tr>
                        <td><%= new Date(loan.created_at).toLocaleDateString() %></td>
                        <td><%= loan.principal %> digipogs</td>
                        <td><%= (loan.interest_rate * 100).toFixed(2) %>%</td>
                        <td><%= loan.amount_owed %> digipogs</td>
                        <td><%= loan.amount_paid %> digipogs</td>
                        <td>
                            <span class="status-badge status-<%= loan.status %>">
                                <%= loan.status.charAt(0).toUpperCase() + loan.status.slice(1) %>
                            </span>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <p style="color: #666;">No loan history yet.</p>
            <% } %>
        </div>
    </div>

    <script>
        function showMessage(elementId, message, type) {
            const element = document.getElementById(elementId);
            element.textContent = message;
            element.className = 'message show alert alert-' + type;
            setTimeout(() => {
                element.classList.remove('show');
            }, 5000);
        }

        async function submitBorrow(event) {
            event.preventDefault();
            const form = event.target;
            const formData = new FormData(form);
            const amount = parseInt(formData.get('amount'));

            if (amount <= 0 || amount > <%= creditLimit %>) {
                showMessage('borrowMessage', 'Invalid loan amount', 'error');
                return false;
            }

            try {
                const response = await fetch('/credit/borrow', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ amount: amount })
                });

                const data = await response.json();
                
                if (data.success) {
                    showMessage('borrowMessage', data.message, 'success');
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                } else {
                    showMessage('borrowMessage', data.error || 'Failed to process loan', 'error');
                }
            } catch (error) {
                showMessage('borrowMessage', 'Error: ' + error.message, 'error');
            }
            return false;
        }

        async function submitRepay(event) {
            event.preventDefault();
            const form = event.target;
            const formData = new FormData(form);
            const amount = parseInt(formData.get('amount'));
            const pin = (formData.get('pin') || '').toString().trim();

            if (amount <= 0) {
                showMessage('repayMessage', 'Invalid repayment amount', 'error');
                return false;
            }
            if (!pin) {
                showMessage('repayMessage', 'PIN is required for repayment.', 'error');
                return false;
            }

            try {
                const response = await fetch('/credit/repay', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ amount: amount, pin: pin })
                });

                const data = await response.json();
                
                if (data.success) {
                    showMessage('repayMessage', data.message, 'success');
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                } else {
                    showMessage('repayMessage', data.error || 'Failed to process repayment', 'error');
                }
            } catch (error) {
                showMessage('repayMessage', 'Error: ' + error.message, 'error');
            }
            return false;
        }

        async function repayFull() {
            const pin = (document.getElementById('repayPin')?.value || '').toString().trim();
            if (!pin) {
                showMessage('repayMessage', 'PIN is required for repayment.', 'error');
                return;
            }
            if (!confirm('Pay the full remaining balance?')) {
                return;
            }

            try {
                const response = await fetch('/credit/repay/full', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ pin: pin })
                });

                const data = await response.json();
                
                if (data.success) {
                    showMessage('repayMessage', data.message, 'success');
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                } else {
                    showMessage('repayMessage', data.error || 'Failed to process full repayment', 'error');
                }
            } catch (error) {
                showMessage('repayMessage', 'Error: ' + error.message, 'error');
            }
        }
    </script>
</body>
</html>

