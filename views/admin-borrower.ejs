<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FormBank - Borrower Profile</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 50%, #0D3D10 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container { max-width: 1100px; margin: 0 auto; }
        .header, .section {
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            padding: 20px 25px;
        }
        .header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
        .header h1 { color: #333; }
        .nav-links a { color: #2E7D32; text-decoration: none; margin-left: 16px; font-weight: 500; }
        .section h2 { color: #333; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid #2E7D32; }
        .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; margin-bottom: 16px; }
        .card { background: #f8f9fa; border-left: 4px solid #2E7D32; padding: 12px; border-radius: 6px; }
        .card .label { font-size: 12px; color: #666; }
        .card .value { font-size: 20px; font-weight: 700; margin-top: 4px; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th, td { padding: 8px 10px; border-bottom: 1px solid #e0e0e0; text-align: left; vertical-align: top; }
        th { background: #f8f9fa; }
        .muted { color: #888; font-size: 13px; }
        .note { font-size: 13px; color: #666; margin-bottom: 12px; }
        .flash { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 14px; }
        .flash-ok { background: #E8F5E9; color: #1B5E20; border: 1px solid #A5D6A7; }
        .flash-err { background: #FFEBEE; color: #B71C1C; border: 1px solid #EF9A9A; }
        .inline-form { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
        .inline-form input, .inline-form select {
            padding: 6px 8px; border: 1px solid #ccc; border-radius: 6px; font-size: 13px; width: 90px;
        }
        .inline-form button, .btn {
            background: #2E7D32; color: white; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 13px;
        }
        .btn-danger { background: #C62828; }
        .edit-box { background: #f8f9fa; padding: 14px; border-radius: 8px; margin-bottom: 16px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div>
                <h1>Borrower profile</h1>
                <p><%- formbarUserLink(profile.userId, userNames) %></p>
            </div>
            <div class="nav-links">
                <a href="/admin/analytics">Analytics</a>
                <a href="/admin">Admin</a>
                <a href="/logout">Logout</a>
            </div>
        </div>

        <% if (typeof flash === 'string' && flash) { %>
        <div class="flash flash-ok"><%= flash %></div>
        <% } %>
        <% if (typeof flashError === 'string' && flashError) { %>
        <div class="flash flash-err"><%= flashError %></div>
        <% } %>

        <div class="section">
            <h2>Summary</h2>
            <div class="cards">
                <div class="card"><div class="label">Credit limit</div><div class="value"><%= profile.creditLimit != null ? profile.creditLimit : '—' %></div></div>
                <div class="card"><div class="label">Limit increases</div><div class="value"><%= profile.paidOffCount %></div></div>
                <div class="card"><div class="label">Outstanding</div><div class="value"><%= profile.outstanding %></div></div>
                <div class="card"><div class="label">Total paid</div><div class="value"><%= profile.totalPaid %></div></div>
                <div class="card"><div class="label">Interest collected</div><div class="value"><%= profile.interestCollected %></div></div>
                <div class="card"><div class="label">Utilization</div><div class="value"><%= (profile.utilization * 100).toFixed(1) %>%</div></div>
            </div>

            <div class="edit-box">
                <h2 style="border:none;margin:0 0 10px;padding:0;font-size:16px;">Edit credit limit</h2>
                <p class="note">Local bookkeeping only — does not move Formbar digipogs.</p>
                <form class="inline-form" method="post" action="/admin/credit-limit">
                    <input type="hidden" name="returnTo" value="/admin/analytics/borrowers/<%= profile.userId %>">
                    <input type="hidden" name="formbarUserId" value="<%= profile.userId %>">
                    <input type="number" name="current_limit" min="1" value="<%= profile.creditLimit != null ? profile.creditLimit : 500 %>" required>
                    <input type="number" name="paid_off_count" min="0" value="<%= profile.paidOffCount || 0 %>">
                    <input type="text" name="note" placeholder="Note" maxlength="200" style="width:160px;">
                    <button type="submit">Save limit</button>
                </form>
            </div>
        </div>

        <div class="section">
            <h2>Lending history</h2>
            <p class="note">Edit balances or status below. Changes are recorded as ledger adjustments.</p>
            <% if (profile.loans && profile.loans.length) { %>
            <table>
                <thead>
                    <tr>
                        <th>ID</th><th>Current</th><th>Status</th><th>Created</th><th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                <% profile.loans.forEach(function(l) { %>
                    <tr>
                        <td><%= l.id %></td>
                        <td>
                            P <%= l.principal %><br>
                            Owed <%= l.amount_owed %><br>
                            Paid <%= l.amount_paid %><br>
                            Bal <%= l.amount_owed - l.amount_paid %>
                        </td>
                        <td><%= l.status %><br><span class="muted"><%= l.paid_at || '' %></span></td>
                        <td><%= l.created_at %></td>
                        <td>
                            <form class="inline-form" method="post" action="/admin/loans/<%= l.id %>">
                                <input type="hidden" name="returnTo" value="/admin/analytics/borrowers/<%= profile.userId %>">
                                <input type="number" name="principal" min="1" value="<%= l.principal %>" required>
                                <input type="number" name="amount_owed" min="0" value="<%= l.amount_owed %>" required>
                                <input type="number" name="amount_paid" min="0" value="<%= l.amount_paid %>" required>
                                <select name="status">
                                    <option value="active" <%= l.status === 'active' ? 'selected' : '' %>>active</option>
                                    <option value="paid" <%= l.status === 'paid' ? 'selected' : '' %>>paid</option>
                                    <option value="void" <%= l.status === 'void' ? 'selected' : '' %>>void</option>
                                    <option value="superseded" <%= l.status === 'superseded' ? 'selected' : '' %>>superseded</option>
                                </select>
                                <button type="submit">Save</button>
                            </form>
                            <% if (l.status === 'active') { %>
                            <form class="inline-form" method="post" action="/admin/loans/<%= l.id %>/void" style="margin-top:6px;" onsubmit="return confirm('Void loan #<%= l.id %> locally?');">
                                <input type="hidden" name="returnTo" value="/admin/analytics/borrowers/<%= profile.userId %>">
                                <button type="submit" class="btn-danger">Void</button>
                            </form>
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <p class="muted">No loans.</p>
            <% } %>
        </div>

        <div class="section">
            <h2>Ledger activity</h2>
            <% if (profile.ledger && profile.ledger.length) { %>
            <table>
                <thead>
                    <tr>
                        <th>When</th><th>Type</th><th>Status</th><th>Gross</th><th>Principal</th><th>Interest</th><th>Fee</th><th>Tax</th>
                    </tr>
                </thead>
                <tbody>
                <% profile.ledger.forEach(function(t) { %>
                    <tr>
                        <td><%= t.created_at %></td>
                        <td><%= t.type %></td>
                        <td><%= t.status %></td>
                        <td><%= t.gross_transfer_amount %></td>
                        <td><%= t.principal_component %></td>
                        <td><%= t.interest_component %></td>
                        <td><%= t.fee_amount %></td>
                        <td><%= t.tax_amount %></td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <p class="muted">No ledger rows for this user.</p>
            <% } %>
        </div>
    </div>
</body>
</html>
